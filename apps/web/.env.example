# Copy to .env.local for development. In Vercel, set these in Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Host names. Requests on ADMIN_HOST are served the admin panel only;
# /admin is blocked on every other host. Leave ADMIN_HOST empty in local dev.
ADMIN_HOST=admin.brewistan.com

# Shown on the billing page.
NEXT_PUBLIC_ZAIN_CASH_NUMBER=07XXXXXXXXX
NEXT_PUBLIC_FIB_ACCOUNT=XXXX-XXXX
NEXT_PUBLIC_SUPPORT_WHATSAPP=9647XXXXXXXXX

# Server-only, required: independent random secret, at least 32 characters.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_SESSION_SECRET=

# Optional: root requests on these hosts open /dashboard, not the public website.
OWNER_HOSTS=dashboard.brewistan.com
CUSTOMER_HOSTS=app.brewistan.com

.card {
  --loyalty-bg: #151311;
  --loyalty-fg: #e8dcc6;
  position: relative;
  isolation: isolate;
  box-sizing: border-box;
  width: 100%;
  padding: clamp(17px, 4.6vw, 23px);
  border: 1px solid color-mix(in srgb, var(--loyalty-fg) 32%, transparent);
  border-radius: 23px;
  color: var(--loyalty-fg);
  background: linear-gradient(142deg, rgba(255,255,255,.065), transparent 56%), var(--loyalty-bg);
  box-shadow: 0 16px 36px -24px rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.08);
  text-align: start;
  font-family: var(--font-sans, system-ui, sans-serif);
  -webkit-font-smoothing: antialiased;
}
.header { display: grid; grid-template-columns: 42px minmax(0,1fr) auto; align-items: center; gap: 12px; }
.logo { position: relative; width: 42px; height: 44px; display: grid; place-items: center; overflow: hidden; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--loyalty-fg) 30%, transparent); background: color-mix(in srgb, var(--loyalty-fg) 7%, var(--loyalty-bg)); font: 500 21px var(--font-card, Georgia, serif); }
.logo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; padding: 5px; background: var(--loyalty-bg); }
.identity { min-width: 0; }
.name { font-family: var(--font-card, Georgia, serif); font-size: clamp(20px, 5.3vw, 25px); font-weight: 600; line-height: 1.15; letter-spacing: -.035em; overflow-wrap: anywhere; }
.tag { margin-top: 5px; font-size: 9px; font-weight: 500; line-height: 1.4; letter-spacing: .17em; text-transform: uppercase; opacity: .73; }
.balance { align-self: center; text-align: end; min-width: 47px; }
.stampLabel { font-size: 9px; line-height: 1.4; letter-spacing: .13em; text-transform: uppercase; opacity: .74; }
.numbers { margin-top: 3px; white-space: nowrap; font-family: var(--font-card, Georgia, serif); font-size: clamp(23px, 6vw, 28px); font-weight: 500; line-height: 1.05; font-variant-numeric: tabular-nums; }
.numbers span { display: inline-block; padding: 0 4px; opacity: .52; font-size: .86em; }
.stamps { display: grid; grid-template-columns: repeat(var(--loyalty-columns), minmax(0,1fr)); gap: clamp(5px, 1.6vw, 8px); margin-top: 21px; }
.stamp { display: grid; place-items: center; width: 100%; max-width: 39px; aspect-ratio: 1; justify-self: center; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--loyalty-fg) 31%, transparent); background: color-mix(in srgb, var(--loyalty-fg) 4%, transparent); }
.stamp svg { display: block; width: 63%; height: 63%; }
.stamp[data-filled='true'] { background: var(--loyalty-fg); color: var(--loyalty-bg); border-color: var(--loyalty-fg); box-shadow: inset 0 1px 0 rgba(255,255,255,.24); }
.reward { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; border-top: 1px solid color-mix(in srgb, var(--loyalty-fg) 24%, transparent); padding-top: 12px; margin-top: 18px; font-size: 12px; line-height: 1.4; }
.goal { min-width: 0; flex: 1; font-weight: 500; overflow-wrap: anywhere; }
.progress { max-width: 48%; font-size: 11px; text-align: end; opacity: .84; overflow-wrap: anywhere; }
.personal { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,auto); align-items: end; column-gap: 16px; margin-top: 14px; padding-top: 12px; border-top: 1px solid color-mix(in srgb, var(--loyalty-fg) 13%, transparent); font-size: 11px; line-height: 1.4; }
.customer { font-weight: 500; letter-spacing: .015em; overflow-wrap: anywhere; }
.activity { display: flex; flex-direction: column; gap: 2px; max-width: 130px; font-size: 10px; text-align: end; opacity: .78; }
.activity time { font-size: 10px; opacity: 1; font-variant-numeric: tabular-nums; }
@media (max-width: 350px) {
  .card { border-radius: 20px; padding: 16px; }
  .header { grid-template-columns: 36px minmax(0,1fr) auto; gap: 9px; }
  .logo { width: 36px; height: 39px; border-radius: 10px; }
  .name { font-size: 20px; }
  .stamps { margin-top: 18px; gap: 5px; }
  .personal { column-gap: 10px; }
}

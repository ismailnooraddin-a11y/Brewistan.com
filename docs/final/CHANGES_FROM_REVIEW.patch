+  return jsonb_build_object(
+    'status', 'accepted',
+    'stamps', case when v_completed then v_campaign.stamps_required else v_new_count end,
+    'required', v_campaign.stamps_required,
+    'puzzle_completed', v_completed,
+    'reward_id', v_reward_id,
+    'flagged', v_flagged);
+end $$;
